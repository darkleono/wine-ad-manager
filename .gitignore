# Autodesk License Server Git Ignore

# Excluir archivos de licencia reales (sensibles)
licence/*.lic
!licence/licenses.lic # Mantener el archivo de prueba si se desea, o excluirlo tambien
# licence/licenses.lic

# Excluir binarios grandes (RPM, TAR, MSI)
bin/*.rpm
bin/*.tar.gz
bin/*.msi
bin/*.json
bin/*.mst

# Logs de FlexNet
*.log
debug.log

# Archivos de sistema y editores
.DS_Store
.idea/
.vscode/
node_modules/

# Archivos de entorno y secrets (CREDENCIALES NUNCA EN GIT)
.env
.env.*
.enviroment
*.env
secrets/
credentials/
*.key
*.pem

# Dashboard authentication (wine-ad-manager)
wine-ad-manager/bin/.htpasswd
wine-ad-manager/bin/.dashboard_auth
wine-ad-manager/bin/.ip_whitelist
