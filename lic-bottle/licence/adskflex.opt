# Autodesk Network License Manager - Options File (adskflex.opt)
# Use este archivo para configurar reglas de uso de licencias.

# Duracion maxima de Borrowing (Prestamo de licencias)
# Formato: MAX_BORROW_HOURS [Producto] [Horas]
# Ejemplo para 2 semanas (336 horas):
# MAX_BORROW_HOURS 87224ACD_2020_0F 336

# Bloquear el borrowing por completo para un producto (comentar con # para permitir)
# EXCLUDE_BORROW 87224ACD_2020_0F USER nombre_usuario

# TIMEOUT: Tiempo de inactividad antes de recuperar la licencia (minimo 900 segundos / 15 min)
TIMEOUTALL 1800

# Grupos de usuarios para reportes o restricciones
# GROUP ingenieria usuario1 usuario2
